rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function masterAdmin() {
      return signedIn() && request.auth.token.email == 'pedrosajpo@gmail.com';
    }

    function admin() {
      return masterAdmin() || (
        signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nivel == 'admin'
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || admin());
      allow create: if admin();
      allow update: if admin() || (signedIn() && uid == request.auth.uid && request.resource.data.email == resource.data.email && request.resource.data.nivel == resource.data.nivel);
      allow delete: if admin() && uid != request.auth.uid;
    }

    match /racha/current {
      allow read, write: if signedIn();
    }

    match /racha/data/archives/{archiveId} {
      allow read, create: if signedIn();
      allow update, delete: if admin();
    }
  }
}
